<?xml version="1.0"?>
<!--
  4-wheel skid-steer rover, URDF (ROS side: tf frames, RViz, ros2_control joints).
  The physics lives in ../mjcf/rover.xml; both files must use the numbers below.
  tools/tests/test_model_consistency.py checks it.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mars_rover">

  <!-- Launch passes the absolute path to the world XML and headless flag.
       Defaults allow plain `xacro rover.urdf.xacro` (used by consistency tests). -->
  <xacro:arg name="mujoco_model" default=""/>
  <xacro:arg name="headless" default="false"/>

  <!-- dimensions (m, kg): see DEVLOG "Phase 1 · Rover dimensions" -->
  <xacro:property name="chassis_x" value="0.8"/>
  <xacro:property name="chassis_y" value="0.5"/>
  <xacro:property name="chassis_z" value="0.2"/>
  <xacro:property name="chassis_mass" value="35.5"/>
  <xacro:property name="wheel_radius" value="0.12"/>
  <xacro:property name="wheel_width" value="0.1"/>
  <xacro:property name="wheel_mass" value="1.0"/>
  <xacro:property name="wheel_x" value="0.25"/>   <!-- half wheelbase -->
  <xacro:property name="wheel_y" value="0.32"/>   <!-- half track -->
  <xacro:property name="wheel_z" value="-0.15"/>  <!-- wheel centre below base_link -->
  <xacro:property name="axle_roll_limit" value="0.35"/>

  <material name="white"><color rgba="0.9 0.9 0.88 1"/></material>
  <material name="dark"><color rgba="0.15 0.15 0.15 1"/></material>

  <!-- base_link = chassis centre (REP 105: x forward, y left, z up) -->
  <link name="base_link">
    <visual>
      <geometry><box size="${chassis_x} ${chassis_y} ${chassis_z}"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry><box size="${chassis_x} ${chassis_y} ${chassis_z}"/></geometry>
    </collision>
    <inertial>
      <mass value="${chassis_mass}"/>
      <inertia ixx="${chassis_mass/12*(chassis_y**2+chassis_z**2)}" ixy="0" ixz="0"
               iyy="${chassis_mass/12*(chassis_x**2+chassis_z**2)}" iyz="0"
               izz="${chassis_mass/12*(chassis_x**2+chassis_y**2)}"/>
    </inertial>
  </link>

  <!-- passive roll pivot carrying the front wheels -->
  <link name="front_axle_link">
    <inertial>
      <mass value="0.5"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.01"/>
    </inertial>
  </link>
  <joint name="front_axle_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_axle_link"/>
    <origin xyz="${wheel_x} 0 ${wheel_z}"/>
    <axis xyz="1 0 0"/>
    <limit lower="${-axle_roll_limit}" upper="${axle_roll_limit}" effort="0" velocity="10"/>
  </joint>

  <xacro:macro name="wheel" params="name parent x y z">
    <link name="wheel_${name}_link">
      <visual>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="dark"/>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_mass/12*(3*wheel_radius**2+wheel_width**2)}" ixy="0" ixz="0"
                 iyy="${wheel_mass/2*wheel_radius**2}" iyz="0"
                 izz="${wheel_mass/12*(3*wheel_radius**2+wheel_width**2)}"/>
      </inertial>
    </link>
    <joint name="wheel_${name}_joint" type="continuous">
      <parent link="${parent}"/>
      <child link="wheel_${name}_link"/>
      <origin xyz="${x} ${y} ${z}"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="fl" parent="front_axle_link" x="0" y="${wheel_y}" z="0"/>
  <xacro:wheel name="fr" parent="front_axle_link" x="0" y="${-wheel_y}" z="0"/>
  <xacro:wheel name="rl" parent="base_link" x="${-wheel_x}" y="${wheel_y}" z="${wheel_z}"/>
  <xacro:wheel name="rr" parent="base_link" x="${-wheel_x}" y="${-wheel_y}" z="${wheel_z}"/>

  <!-- sensors: same poses as the MJCF sites -->
  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.06"/></geometry>
      <material name="dark"/>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.3 0 0.4"/>
  </joint>

  <!-- Only emit ros2_control when a MuJoCo world path is provided.
       Plain `xacro rover.urdf.xacro` (no args) omits it so tools/tests/test_model_consistency.py
       can iterate all <joint> elements without encountering ros2_control <joint> tags. -->
  <xacro:property name="mujoco_model_path" value="$(arg mujoco_model)"/>
  <xacro:if value="${mujoco_model_path != ''}">
    <ros2_control name="MujocoSystem" type="system">
      <hardware>
        <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
        <param name="mujoco_model">${mujoco_model_path}</param>
        <param name="headless">$(arg headless)</param>
        <param name="sim_speed_factor">1.0</param>
        <param name="odom_free_joint_name">base_free_joint</param>
      </hardware>

      <!-- 4 driven wheels: velocity command + position/velocity/effort state -->
      <xacro:macro name="wheel_ros2_control" params="name">
        <joint name="wheel_${name}_joint">
          <command_interface name="velocity"/>
          <state_interface name="position">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="velocity">
            <param name="initial_value">0.0</param>
          </state_interface>
          <state_interface name="effort"/>
        </joint>
      </xacro:macro>

      <xacro:wheel_ros2_control name="fl"/>
      <xacro:wheel_ros2_control name="fr"/>
      <xacro:wheel_ros2_control name="rl"/>
      <xacro:wheel_ros2_control name="rr"/>

      <!-- Passive front axle roll pivot: state-only so joint_state_broadcaster publishes it -->
      <joint name="front_axle_joint">
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>

      <!-- IMU sensor: maps to MJCF base_imu_quat, base_imu_gyro, base_imu_accel -->
      <sensor name="base_imu">
        <param name="mujoco_type">imu</param>
        <state_interface name="orientation.x"/>
        <state_interface name="orientation.y"/>
        <state_interface name="orientation.z"/>
        <state_interface name="orientation.w"/>
        <state_interface name="angular_velocity.x"/>
        <state_interface name="angular_velocity.y"/>
        <state_interface name="angular_velocity.z"/>
        <state_interface name="linear_acceleration.x"/>
        <state_interface name="linear_acceleration.y"/>
        <state_interface name="linear_acceleration.z"/>
      </sensor>
    </ros2_control>
  </xacro:if>

</robot>
